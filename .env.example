# Copy this file to .env and fill in your own key (https://www.themoviedb.org/settings/api).
# Only needed to re-run src/fetch_titles.py.
TMDB_API_KEY=

# Only needed to download the votes (src/pull_votes.py): the project URL and the
# SECRET key of your Supabase project. Never commit them and never put them in app/config.js.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
